<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- In a collection row's detail: how many spots it holds. -->
	<key>collections.row.spots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d спот</string>
			<key>few</key>
			<string>%d споти</string>
			<key>many</key>
			<string>%d спотів</string>
			<key>other</key>
			<string>%d спота</string>
		</dict>
	</dict>
	<!-- In a collection row's detail: a private collection and how many people it's shared with. -->
	<key>collections.row.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Приватна · доступ має %d людина</string>
			<key>few</key>
			<string>Приватна · доступ мають %d людини</string>
			<key>many</key>
			<string>Приватна · доступ мають %d людей</string>
			<key>other</key>
			<string>Приватна · доступ мають %d людини</string>
		</dict>
	</dict>
	<!-- In the byline under a collection's name: a private collection and how many people it's shared with. -->
	<key>collection.byline.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Приватна, доступ має %d людина</string>
			<key>few</key>
			<string>Приватна, доступ мають %d людини</string>
			<key>many</key>
			<string>Приватна, доступ мають %d людей</string>
			<key>other</key>
			<string>Приватна, доступ мають %d людини</string>
		</dict>
	</dict>
	<!-- Asked before a collection goes public, when private spots are in it. -->
	<key>access.makePublic.privateSpotsMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Її бачить будь-хто, хто ввійшов в акаунт за посиланням, зокрема %#@spots@, і вона вказана у вашому профілі.</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d приватний спот</string>
			<key>few</key>
			<string>%d приватні споти</string>
			<key>many</key>
			<string>%d приватних спотів</string>
			<key>other</key>
			<string>%d приватного спота</string>
		</dict>
	</dict>
</dict>
</plist>
