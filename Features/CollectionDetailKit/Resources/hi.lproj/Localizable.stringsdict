<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- In a collection row's detail: how many spots it holds. -->
	<key>collections.row.spots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d स्पॉट</string>
			<key>other</key>
			<string>%d स्पॉट</string>
		</dict>
	</dict>
	<!-- In a collection row's detail: a private collection and how many people it's shared with. -->
	<key>collections.row.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>निजी · %d के साथ शेयर</string>
			<key>other</key>
			<string>निजी · %d के साथ शेयर</string>
		</dict>
	</dict>
	<!-- In the byline under a collection's name: a private collection and how many people it's shared with. -->
	<key>collection.byline.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>निजी, %d के साथ शेयर</string>
			<key>other</key>
			<string>निजी, %d के साथ शेयर</string>
		</dict>
	</dict>
	<!-- Asked before a collection goes public, when private spots are in it. -->
	<key>access.makePublic.privateSpotsMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>लिंक के साथ साइन इन कोई भी इसे देख सकता है, इसमें मौजूद %#@spots@ भी, और आपकी प्रोफ़ाइल इसे दिखाएगी।</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d निजी स्पॉट</string>
			<key>other</key>
			<string>%d निजी स्पॉट</string>
		</dict>
	</dict>
</dict>
</plist>
