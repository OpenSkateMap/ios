<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- In a collection row's detail: how many spots it holds. -->
	<key>collections.row.spots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d Spot</string>
			<key>other</key>
			<string>%d Spots</string>
		</dict>
	</dict>
	<!-- In a collection row's detail: a private collection and how many people it's shared with. -->
	<key>collections.row.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Privat · mit %d Person geteilt</string>
			<key>other</key>
			<string>Privat · mit %d Personen geteilt</string>
		</dict>
	</dict>
	<!-- In the byline under a collection's name: a private collection and how many people it's shared with. -->
	<key>collection.byline.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Privat, mit %d Person geteilt</string>
			<key>other</key>
			<string>Privat, mit %d Personen geteilt</string>
		</dict>
	</dict>
	<!-- Asked before a collection goes public, when private spots are in it. -->
	<key>access.makePublic.privateSpotsMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Alle, die angemeldet sind und den Link haben, können sie sehen – darunter %#@spots@ – und dein Profil listet sie auf.</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d privater Spot</string>
			<key>other</key>
			<string>%d private Spots</string>
		</dict>
	</dict>
</dict>
</plist>
