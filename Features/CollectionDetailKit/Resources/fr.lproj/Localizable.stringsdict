<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- In a collection row's detail: how many spots it holds. -->
	<key>collections.row.spots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d spot</string>
			<key>many</key>
			<string>%d de spots</string>
			<key>other</key>
			<string>%d spots</string>
		</dict>
	</dict>
	<!-- In a collection row's detail: a private collection and how many people it's shared with. -->
	<key>collections.row.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Privée · partagée avec %d personne</string>
			<key>many</key>
			<string>Privée · partagée avec %d de personnes</string>
			<key>other</key>
			<string>Privée · partagée avec %d personnes</string>
		</dict>
	</dict>
	<!-- In the byline under a collection's name: a private collection and how many people it's shared with. -->
	<key>collection.byline.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Privée, partagée avec %d personne</string>
			<key>many</key>
			<string>Privée, partagée avec %d de personnes</string>
			<key>other</key>
			<string>Privée, partagée avec %d personnes</string>
		</dict>
	</dict>
	<!-- Asked before a collection goes public, when private spots are in it. -->
	<key>access.makePublic.privateSpotsMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Toute personne connectée disposant du lien peut la voir, y compris %#@spots@, et votre profil la liste.</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d spot privé</string>
			<key>many</key>
			<string>%d de spots privés</string>
			<key>other</key>
			<string>%d spots privés</string>
		</dict>
	</dict>
</dict>
</plist>
