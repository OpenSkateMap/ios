<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- In a collection row's detail: how many spots it holds. -->
	<key>collections.row.spots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d pico</string>
			<key>other</key>
			<string>%d picos</string>
			<key>many</key>
			<string>%d de picos</string>
		</dict>
	</dict>
	<!-- In a collection row's detail: a private collection and how many people it's shared with. -->
	<key>collections.row.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Privada · compartilhada com %d pessoa</string>
			<key>other</key>
			<string>Privada · compartilhada com %d pessoas</string>
			<key>many</key>
			<string>Privada · compartilhada com %d de pessoas</string>
		</dict>
	</dict>
	<!-- In the byline under a collection's name: a private collection and how many people it's shared with. -->
	<key>collection.byline.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Privada, compartilhada com %d pessoa</string>
			<key>other</key>
			<string>Privada, compartilhada com %d pessoas</string>
			<key>many</key>
			<string>Privada, compartilhada com %d de pessoas</string>
		</dict>
	</dict>
	<!-- Asked before a collection goes public, when private spots are in it. -->
	<key>access.makePublic.privateSpotsMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Qualquer pessoa conectada com o link pode ver, incluindo %#@spots@ nela, e seu perfil a lista.</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d pico privado</string>
			<key>other</key>
			<string>%d picos privados</string>
			<key>many</key>
			<string>%d de picos privados</string>
		</dict>
	</dict>
</dict>
</plist>
