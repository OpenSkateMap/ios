<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- In a collection row's detail: how many spots it holds. -->
	<key>collections.row.spots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>لا سبوتات</string>
			<key>one</key>
			<string>سبوت واحد</string>
			<key>two</key>
			<string>سبوتان</string>
			<key>few</key>
			<string>%d سبوتات</string>
			<key>many</key>
			<string>%d سبوتًا</string>
			<key>other</key>
			<string>%d سبوت</string>
		</dict>
	</dict>
	<!-- In a collection row's detail: a private collection and how many people it's shared with. -->
	<key>collections.row.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>خاصة</string>
			<key>one</key>
			<string>خاصة · مشاركة مع شخص واحد</string>
			<key>two</key>
			<string>خاصة · مشاركة مع شخصين</string>
			<key>few</key>
			<string>خاصة · مشاركة مع %d أشخاص</string>
			<key>many</key>
			<string>خاصة · مشاركة مع %d شخصًا</string>
			<key>other</key>
			<string>خاصة · مشاركة مع %d شخص</string>
		</dict>
	</dict>
	<!-- In the byline under a collection's name: a private collection and how many people it's shared with. -->
	<key>collection.byline.sharedWith</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@people@</string>
		<key>people</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>خاصة</string>
			<key>one</key>
			<string>خاصة، مشاركة مع شخص واحد</string>
			<key>two</key>
			<string>خاصة، مشاركة مع شخصين</string>
			<key>few</key>
			<string>خاصة، مشاركة مع %d أشخاص</string>
			<key>many</key>
			<string>خاصة، مشاركة مع %d شخصًا</string>
			<key>other</key>
			<string>خاصة، مشاركة مع %d شخص</string>
		</dict>
	</dict>
	<!-- Asked before a collection goes public, when private spots are in it. -->
	<key>access.makePublic.privateSpotsMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>يمكن لأي شخص مسجّل الدخول ولديه الرابط رؤيتها، بما في ذلك %#@spots@ فيها، وسيعرضها ملفك الشخصي.</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>لا سبوتات خاصة</string>
			<key>one</key>
			<string>سبوت خاص واحد</string>
			<key>two</key>
			<string>سبوتين خاصين</string>
			<key>few</key>
			<string>%d سبوتات خاصة</string>
			<key>many</key>
			<string>%d سبوتًا خاصًا</string>
			<key>other</key>
			<string>%d سبوت خاص</string>
		</dict>
	</dict>
</dict>
</plist>
