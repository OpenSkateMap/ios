<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Contribute card's summary: how many spots the person added. Joined with the two below by " · ". -->
	<key>contribute.hero.summary.added</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld hinzugefügt</string>
			<key>other</key>
			<string>%ld hinzugefügt</string>
		</dict>
	</dict>
	<!-- The Contribute card's summary: how many of the person's spots are published. -->
	<key>contribute.hero.summary.onTheMap</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld auf der Karte</string>
			<key>other</key>
			<string>%ld auf der Karte</string>
		</dict>
	</dict>
	<!-- The Contribute card's summary: how many of the person's spots and edits a curator hasn't decided yet. -->
	<key>contribute.hero.summary.waiting</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@spots@</string>
		<key>spots</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld wartet auf Prüfung</string>
			<key>other</key>
			<string>%ld warten auf Prüfung</string>
		</dict>
	</dict>
	<!-- The Review Queue row's subtitle: how many spots, edits and videos wait for this curator. -->
	<key>contribute.reviewQueue.waiting</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld wartet auf dich</string>
			<key>other</key>
			<string>%ld warten auf dich</string>
		</dict>
	</dict>
	<!-- A suggested edit's change line on a review card: the photos it adds. -->
	<key>reviewCard.changes.photos</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@photos@</string>
		<key>photos</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Fügt ein Foto hinzu</string>
			<key>other</key>
			<string>Fügt %ld Fotos hinzu</string>
		</dict>
	</dict>
	<key>reviewCard.changes.photosRemoved</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@photos@</string>
		<key>photos</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Entfernt ein Foto</string>
			<key>other</key>
			<string>Entfernt %ld Fotos</string>
		</dict>
	</dict>
</dict>
</plist>
