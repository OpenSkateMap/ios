/* Discover's list before the map has been in any of our cities. */
"discover.noCity.title" = "Find a City";
"discover.noCity.detail" = "Move the map to a city with spots, or search for one.";
/* Discover's heading over the spots in view when the map is outside every city and MapKit has no name for the place. */
