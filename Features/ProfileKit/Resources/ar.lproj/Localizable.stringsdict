<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The caption under the number of cities someone has spots in (the number is shown above it, not in the caption). -->
	<key>profile.stats.cities.caption</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>zero</key>
			<string>مدن</string>
			<key>one</key>
			<string>مدينة</string>
			<key>two</key>
			<string>مدينتان</string>
			<key>few</key>
			<string>مدن</string>
			<key>many</key>
			<string>مدينة</string>
			<key>other</key>
			<string>مدينة</string>
		</dict>
	</dict>
	<!-- VoiceOver: the number of spots someone submitted, e.g. "12 submitted". -->
	<key>profile.stats.a11y.submitted</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>zero</key>
			<string>لا سبوتات مرسلة</string>
			<key>one</key>
			<string>سبوت واحد مرسل</string>
			<key>two</key>
			<string>سبوتان مرسلان</string>
			<key>few</key>
			<string>%ld سبوتات مرسلة</string>
			<key>many</key>
			<string>%ld سبوتًا مرسلًا</string>
			<key>other</key>
			<string>%ld سبوت مرسل</string>
		</dict>
	</dict>
	<!-- VoiceOver: the number of someone's spots that were approved, e.g. "9 approved". -->
	<key>profile.stats.a11y.approved</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>zero</key>
			<string>لا سبوتات معتمدة</string>
			<key>one</key>
			<string>سبوت واحد معتمد</string>
			<key>two</key>
			<string>سبوتان معتمدان</string>
			<key>few</key>
			<string>%ld سبوتات معتمدة</string>
			<key>many</key>
			<string>%ld سبوتًا معتمدًا</string>
			<key>other</key>
			<string>%ld سبوت معتمد</string>
		</dict>
	</dict>
	<!-- VoiceOver: the number of cities someone has spots in, e.g. "3 cities". -->
	<key>profile.stats.a11y.cities</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>zero</key>
			<string>لا مدن</string>
			<key>one</key>
			<string>مدينة واحدة</string>
			<key>two</key>
			<string>مدينتان</string>
			<key>few</key>
			<string>%ld مدن</string>
			<key>many</key>
			<string>%ld مدينة</string>
			<key>other</key>
			<string>%ld مدينة</string>
		</dict>
	</dict>
</dict>
</plist>
