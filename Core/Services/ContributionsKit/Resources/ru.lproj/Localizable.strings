/* Why a spot or video failed to send and won't be retried by itself, under "Couldn't Send", in Your Spots or on a spot's page. Plain words that say what to do. */
"outbox.problem.photo" = "Не удалось отправить фото. Попробуйте ещё раз или уберите его и отправьте остальное.";
/* A clip is the short video a spot photo can carry. */
"outbox.problem.clip" = "Не удалось отправить ролик. Попробуйте ещё раз или уберите его и отправьте фото.";
/* When the spot itself was turned down, or for a reason the app can't explain. */
"outbox.problem.refused" = "У нас что-то пошло не так. Попробуйте чуть позже.";
"outbox.problem.device" = "Этот спот нельзя отправить с этого устройства";
"outbox.problem.video" = "Это видео нельзя отправить";
"outbox.problem.videoAlreadyThere" = "Это видео уже есть на споте или ждёт проверки";

/* The title of the system's progress banner (a Live Activity) while the photos of a spot someone just sent upload after they leave the app. Like a system title. */
"outbox.upload.title" = "Загрузка спота";

/* Under "Uploading Spot" in that banner: which photo is uploading, e.g. "Photo 2 of 5". */
"outbox.upload.photo" = "Фото %1$ld из %2$ld";
