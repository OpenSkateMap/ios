/* Why a spot or video failed to send and won't be retried by itself, under "Couldn't Send", in Your Spots or on a spot's page. Plain words that say what to do. */
"outbox.problem.photo" = "Não foi possível enviar uma foto. Tente novamente ou remova-a e envie o resto.";
/* A clip is the short video a spot photo can carry. */
"outbox.problem.clip" = "Não foi possível enviar um clipe. Tente novamente ou remova-o e envie as fotos.";
/* When the spot itself was turned down, or for a reason the app can't explain. */
"outbox.problem.refused" = "Algo deu errado do nosso lado. Tente de novo daqui a pouco.";
"outbox.problem.device" = "Este pico não pode ser enviado deste dispositivo";
"outbox.problem.video" = "Este vídeo não pode ser enviado";
"outbox.problem.videoAlreadyThere" = "Este vídeo já está no pico ou aguardando revisão";

/* The title of the system's progress banner (a Live Activity) while the photos of a spot someone just sent upload after they leave the app. Like a system title. */
"outbox.upload.title" = "Enviando pico";

/* Under "Uploading Spot" in that banner: which photo is uploading, e.g. "Photo 2 of 5". */
"outbox.upload.photo" = "Foto %1$ld de %2$ld";
