/* Why a spot or video failed to send and won't be retried by itself, under "Couldn't Send", in Your Spots or on a spot's page. Plain words that say what to do. */
"outbox.problem.photo" = "Ein Foto konnte nicht gesendet werden. Versuche es erneut oder entferne es und sende den Rest.";
/* A clip is the short video a spot photo can carry. */
"outbox.problem.clip" = "Ein Clip konnte nicht gesendet werden. Versuche es erneut oder entferne ihn und sende die Fotos.";
/* When the spot itself was turned down, or for a reason the app can't explain. */
"outbox.problem.refused" = "Bei uns ist etwas schiefgelaufen. Versuche es gleich noch einmal.";
"outbox.problem.device" = "Dieser Spot kann von diesem Gerät nicht gesendet werden";
"outbox.problem.video" = "Dieses Video kann nicht gesendet werden";
"outbox.problem.videoAlreadyThere" = "Dieses Video ist schon beim Spot oder wartet auf Prüfung";

/* The title of the system's progress banner (a Live Activity) while the photos of a spot someone just sent upload after they leave the app. Like a system title. */
"outbox.upload.title" = "Spot wird hochgeladen";

/* Under "Uploading Spot" in that banner: which photo is uploading, e.g. "Photo 2 of 5". */
"outbox.upload.photo" = "Foto %1$ld von %2$ld";
