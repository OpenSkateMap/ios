#!/usr/bin/env bash
#MISE description="CI only: put the fixed OpenSkateMap CI development identity (CI_SIGNING_P12) in a temporary keychain"
set -euo pipefail

# Archives sign with Apple Development; exports re-sign with Apple's cloud-managed distribution certificate through the
# App Store Connect key. A fresh runner has no development identity and would mint one per run (Apple caps them), so the
# workflows import this one: certificate 46527CWCSP, "Apple Development: Created via API", until 2027-10-15, from the
# release environment's CI_SIGNING_* secrets.
: "${CI_SIGNING_P12:?set the CI_SIGNING_P12 secret (base64 .p12)}"
: "${CI_SIGNING_P12_PASSWORD:?set the CI_SIGNING_P12_PASSWORD secret}"
: "${RUNNER_TEMP:?CI only}"

keychain="$RUNNER_TEMP/signing.keychain-db"
password="$(openssl rand -hex 16)"
security create-keychain -p "$password" "$keychain"
security set-keychain-settings -lut 21600 "$keychain"
security unlock-keychain -p "$password" "$keychain"
printf '%s' "$CI_SIGNING_P12" | base64 --decode > "$RUNNER_TEMP/ci-signing.p12"
security import "$RUNNER_TEMP/ci-signing.p12" -k "$keychain" -P "$CI_SIGNING_P12_PASSWORD" -T /usr/bin/codesign -T /usr/bin/security
rm "$RUNNER_TEMP/ci-signing.p12"
# Lets codesign use the key without a prompt.
security set-key-partition-list -S apple-tool:,apple: -s -k "$password" "$keychain" > /dev/null
# shellcheck disable=SC2046
security list-keychains -d user -s "$keychain" $(security list-keychains -d user | tr -d '"')
security find-identity -v -p codesigning "$keychain"
