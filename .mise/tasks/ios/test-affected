#!/usr/bin/env bash
#MISE description="Test the modules a change reaches, each with its own scheme (-- --plan to only print, -- --base <ref>, or -- <files>)"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

exec env PYTHONPATH=.mise/lib PYTHONDONTWRITEBYTECODE=1 python3 - "$@" <<'PY'
import argparse
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys

from modules import TIERS, read_modules

root = pathlib.Path.cwd()
parser = argparse.ArgumentParser(prog="mise run ios:test-affected --")
parser.add_argument("--base", default="origin/main", help="compare with the merge base of HEAD and this ref (default: origin/main)")
parser.add_argument("--plan", action="store_true", help="print what would run, then stop")
parser.add_argument("files", nargs="*", help="test what these files reach instead of the diff")
args = parser.parse_args()

# Everything builds on these; ios.yml's DEVELOPER_DIR is the Xcode version.
EVERYTHING = re.compile(
    r"^(Tuist/|xcconfigs/|\.github/actions/|\.github/workflows/ios\.yml$|Workspace\.swift$|Tuist\.swift$|\.mise\.toml$"
    r"|\.mise/lib/modules\.py$|\.mise/tasks/ios/test-affected$)|(^|/)Project\.swift$"
)
# Each scheme costs a test launch (~10 s); past four, one app-scheme build with -only-testing is quicker.
MAX_SCHEMES = 4

modules = read_modules(root)
workflow = (root / ".github/workflows/ios.yml").read_text()


def from_workflow(pattern, what):
    match = re.search(pattern, workflow, re.M)
    if match is None:
        sys.exit(f"ios.yml no longer sets {what}; update ios:test-affected")
    return match[1]


def git(*arguments):
    return subprocess.run(["git", *arguments], capture_output=True, text=True, check=True).stdout


def changed_files():
    if args.files:
        return args.files
    merge_base = subprocess.run(["git", "merge-base", "HEAD", args.base], capture_output=True, text=True)
    if merge_base.returncode != 0:
        return None
    # The working tree against the merge base: commits since, staged and unstaged changes, and new files.
    return sorted(
        set(git("diff", "--name-only", "--no-renames", merge_base.stdout.strip()).split())
        | set(git("ls-files", "--others", "--exclude-standard").split())
    )


def reach(names):
    seen, stack = set(), list(names)
    while stack:
        name = stack.pop()
        if name in seen or name not in modules:
            continue
        seen.add(name)
        stack.extend(modules[name]["projects"])
    return seen


changed = changed_files()
if changed is None:
    print(f"No merge base with {args.base}: testing everything.")
everything = changed is None or any(EVERYTHING.search(path) for path in changed)
changed = changed or []

directories = {f"{module['directory']}/": name for name, module in modules.items()}
touched = {name for path in changed for directory, name in directories.items() if path.startswith(directory)}
tested = sorted(
    (name for name, module in modules.items() if module["has_tests"] and reach([name, *module["test_projects"]]) & touched),
    key=lambda name: (TIERS[modules[name]["tier"]], name),
)

# CI's own rules, read from ios.yml so they never drift: when its Snapshots job runs, and the Xcode they're recorded with.
snapshot_paths = re.compile(from_workflow(r"^\s*snapshots='([^']+)'$", "snapshots='<pattern>' in its What changed step"))
recorded_xcode = from_workflow(r"DEVELOPER_DIR: /Applications/Xcode_([\d.]+)\.app", "DEVELOPER_DIR")
local_xcode = re.search(r"Xcode ([\d.]+)", subprocess.run(["xcodebuild", "-version"], capture_output=True, text=True, check=True).stdout)[1]
wants_snapshots = any(snapshot_paths.search(path) for path in changed)
snapshots = wants_snapshots and local_xcode.split(".")[:2] == recorded_xcode.split(".")[:2]

tests = [] if snapshots else ["-skip-testing-tags", "snapshot"]
if everything:
    runs = [["-scheme", "OpenSkateMap", *tests]]
    print("Testing everything: a change reaches the build itself.")
elif not tested:
    print(f"No tests reach the {len(changed)} changed files.")
    sys.exit(0)
elif len(tested) <= MAX_SCHEMES:
    runs = [["-scheme", name, *tests] for name in tested]
    print(f"Testing {', '.join(tested)}, each with its own scheme.")
else:
    runs = [["-scheme", "OpenSkateMap", *tests, *(f"-only-testing:{name}Tests" for name in tested)]]
    print(f"Testing {', '.join(tested)} through the app scheme.")
if snapshots:
    print("Snapshots included, as CI's Snapshots job would run.")
elif wants_snapshots:
    print(f"Snapshots skipped: they're recorded with Xcode {recorded_xcode}, and this is Xcode {local_xcode}.")
else:
    print("Snapshots skipped, as CI's Snapshots job would be.")

simulator = os.environ.get("SIMULATOR") or subprocess.run(
    ["mise", "run", "-q", "ios:simulator-id"], capture_output=True, text=True, check=True
).stdout.strip()
# xcslot builds in a warm slot and generates the workspace there; without it, the checkout's workspace builds.
build = ["xcslot", "xcodebuild", "--slots", "1"] if shutil.which("xcslot") else ["xcodebuild"]
summarize = ["xcsift", "-f", "toon", "-w"] if shutil.which("xcsift") else None
for run in runs:
    command = [
        *build, "-workspace", "OpenSkateMap.xcworkspace", *run, "-destination", f"platform=iOS Simulator,id={simulator}",
        *([] if summarize else ["-quiet"]), "test", "COMPILER_INDEX_STORE_ENABLE=NO",
    ]
    print(shlex.join(command), flush=True)
    if args.plan:
        continue
    if summarize:
        xcodebuild = subprocess.Popen(command, stdout=subprocess.PIPE)
        summary = subprocess.run(summarize, stdin=xcodebuild.stdout)
        xcodebuild.stdout.close()
        status = xcodebuild.wait() or summary.returncode
    else:
        status = subprocess.run(command).returncode
    if status != 0:
        sys.exit(status)
PY
