#!/usr/bin/env python3
#MISE description="Print the UDID of an iPhone simulator on the selected Xcode's iOS runtime (CI: mise run -q ios:simulator-id)"
"""Prints the UDID of an iPhone simulator on the iOS runtime the selected Xcode ships with, so CI never hard-codes a
device name and the snapshots run on the runtime they were recorded on, not the newest one the runner image has."""
import json
import re
import subprocess
import sys


def run(*command):
    return subprocess.run(command, capture_output=True, text=True, check=True).stdout


sdk = tuple(int(part) for part in run("xcrun", "--sdk", "iphonesimulator", "--show-sdk-version").split(".")[:2])
devices = json.loads(run("xcrun", "simctl", "list", "devices", "available", "-j"))["devices"]

# Some runtime keys name a device after the version (CI's image has an iPhone19 one): read only the version.
for runtime, entries in devices.items():
    match = re.search(r"\.iOS-(\d+)-(\d+)", runtime)
    if not match or (int(match[1]), int(match[2])) != sdk:
        continue
    for device in entries:
        if device["name"].startswith("iPhone"):
            print(f"{device['name']}, iOS {match[1]}.{match[2]}: {device['udid']}", file=sys.stderr)
            print(device["udid"])
            sys.exit(0)
sys.exit(f"No available iPhone simulator on iOS {'.'.join(map(str, sdk))}, the selected Xcode's runtime")
