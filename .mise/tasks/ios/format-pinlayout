#!/usr/bin/env python3
#MISE description="Order PinLayout chains as its style guide does (pass --check to only report, --self-test to test)"
"""PinLayout's style guide (README, "PinLayout style guide"): calls in the order PinLayout applies them,
`[EDGE|ANCHOR|RELATIVE].[WIDTH|HEIGHT|SIZE].[pinEdges()].[MARGINS].[sizeToFit()]`, and edges top, bottom, start,
end (left and right rank with them, for the few placements that are physical). The order never changes the layout
(the README says so), so the calls are sorted in place: each call keeps the whitespace of the slot it lands in, so
line breaks stay where they were. A chain with a call this list doesn't know is left alone.
"""
import subprocess
import sys
from pathlib import Path

RANK = {
    "all": 0, "center": 1,
    "topLeft": 2, "topCenter": 2, "topRight": 2, "topStart": 2, "topEnd": 2,
    "centerLeft": 3, "centerRight": 3, "centerStart": 3, "centerEnd": 3,
    "bottomLeft": 4, "bottomCenter": 4, "bottomRight": 4, "bottomStart": 4, "bottomEnd": 4,
    "top": 10, "below": 11, "vertically": 12, "verticallyBetween": 12, "vCenter": 13, "above": 14, "bottom": 15,
    "left": 20, "start": 20, "after": 21, "horizontally": 22, "horizontallyBetween": 22, "hCenter": 23,
    "before": 24, "right": 25, "end": 25,
    "width": 30, "minWidth": 31, "maxWidth": 32, "height": 33, "minHeight": 34, "maxHeight": 35, "size": 36,
    "aspectRatio": 37,
    "pinEdges": 40,
    "justify": 42, "align": 43,
    "margin": 50, "marginVertical": 51, "marginTop": 52, "marginBottom": 53, "marginHorizontal": 54,
    "marginLeft": 55, "marginStart": 55, "marginRight": 56, "marginEnd": 56,
    "sizeToFit": 60,
}


def scan_args(text: str, start: int) -> int:
    """`start` is just past a `(`; returns the index just past its matching `)`, or -1."""
    depth, i, n = 1, start, len(text)
    while i < n:
        c = text[i]
        if c == '"':
            i += 1
            while i < n and text[i] != '"':
                i += 2 if text[i] == "\\" else 1
        elif c in "([{":
            depth += 1
        elif c in ")]}":
            depth -= 1
            if depth == 0:
                return i + 1
        i += 1
    return -1


def chain_calls(text: str, start: int):
    """The calls of the chain starting right after `pin` at `start`: (whitespace, call text) pairs, and the end."""
    calls, i = [], start
    while True:
        j = i
        while j < len(text) and text[j] in " \t\n":
            j += 1
        if j >= len(text) or text[j] != ".":
            break
        k = j + 1
        while k < len(text) and (text[k].isalnum() or text[k] == "_"):
            k += 1
        name = text[j + 1:k]
        if not name or k >= len(text) or text[k] != "(":
            break
        end = scan_args(text, k + 1)
        if end < 0:
            break
        calls.append((text[i:j], text[j:end], name))
        i = end
    return calls, i


def is_pin(text: str, at: int) -> bool:
    """`pin` at `at` is a PinLayout receiver: `view.pin` or a bare `pin`, not part of a longer name."""
    before = text[at - 1] if at > 0 else " "
    after = text[at + 3] if at + 3 < len(text) else " "
    return not (before.isalnum() or before == "_") and after == "."


def reorder(text: str) -> tuple[str, int]:
    out, i, changed = [], 0, 0
    while True:
        at = text.find("pin.", i)
        if at < 0:
            out.append(text[i:])
            break
        if not is_pin(text, at):
            out.append(text[i:at + 4])
            i = at + 4
            continue
        calls, end = chain_calls(text, at + 3)
        out.append(text[i:at + 3])
        if len(calls) < 2 or any(name not in RANK for _, _, name in calls):
            out.append(text[at + 3:end])
            i = end
            continue
        ordered = sorted(calls, key=lambda call: RANK[call[2]])
        if ordered != calls:
            changed += 1
        out.append("".join(space + call for (space, _, _), (_, call, _) in zip(calls, ordered)))
        i = end
    return "".join(out), changed


def swift_files() -> list[str]:
    listed = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "--", "*.swift"],
        capture_output=True, text=True, check=True,
    ).stdout.split()
    return [f for f in listed if allowed(f)]


def allowed(path: str) -> bool:
    skipped = ("/Derived/", "Tuist/.build/", ".swift-openapi-generator/", "Core/Foundation/APIClientKit/Sources/Generated/",
               "Lint/fixtures/")
    return path.endswith(".swift") and not any(part in f"/{path}" or path.startswith(part) for part in skipped) \
        and Path(path).is_file()


def self_test() -> None:
    cases = [
        ("label.pin.left(x).top(y).width(w).sizeToFit(.width)", "label.pin.top(y).left(x).width(w).sizeToFit(.width)"),
        ("view.pin.below(of: a).marginTop(2).left(m).width(w)", "view.pin.below(of: a).left(m).width(w).marginTop(2)"),
        ("view.pin.right(10).bottom(5).size(36)", "view.pin.bottom(5).right(10).size(36)"),
        ("view.pin.marginStart(4).end(16).top(t).start(8)", "view.pin.top(t).start(8).end(16).marginStart(4)"),
        ("view.pin.after(of: a).marginLeft(10).right(16).top(t).height(h)",
         "view.pin.top(t).after(of: a).right(16).height(h).marginLeft(10)"),
        ("v.pin.below(of: t)\n    .marginTop(4).before(of: s)", "v.pin.below(of: t)\n    .before(of: s).marginTop(4)"),
        ("v.pin.width(min(a, b)).top(v.pin.safeArea.top + 8)", "v.pin.top(v.pin.safeArea.top + 8).width(min(a, b))"),
        ("v.pin.top().bottom().left(10%).right(10%)", "v.pin.top().bottom().left(10%).right(10%)"),
        ("let top = view.pin.safeArea.top", "let top = view.pin.safeArea.top"),
        ("v.pin.left().custom(1).top()", "v.pin.left().custom(1).top()"),
        ("spin.left(1).top(2)", "spin.left(1).top(2)"),
        ("pin.left().top()", "pin.top().left()"),
    ]
    failed = 0
    for given, expected in cases:
        got, _ = reorder(given)
        if got != expected:
            failed += 1
            print(f"self-test failed:\n  given    {given!r}\n  expected {expected!r}\n  got      {got!r}")
    if failed:
        sys.exit(1)
    print(f"PinLayout ordering verified against {len(cases)} cases.")


def main() -> None:
    args = sys.argv[1:]
    if "--self-test" in args:
        self_test()
        return
    check = "--check" in args or "--lint" in args
    paths = [a for a in args if a.endswith(".swift")]
    files = [p for p in paths if allowed(p)] if paths else swift_files()
    unordered = []
    for path in files:
        source = Path(path).read_text()
        ordered, changed = reorder(source)
        if changed:
            unordered.append((path, changed))
            if not check:
                Path(path).write_text(ordered)
    if check and unordered:
        for path, count in unordered:
            print(f"{path}: {count} PinLayout chain(s) out of the style guide's order (mise run ios:format)")
        sys.exit(1)


if __name__ == "__main__":
    main()
