#!/usr/bin/env bash
#MISE description="Fail when a module depends up a tier or on another feature, declares a dependency it never imports, or imports one of ours it doesn't declare"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

exec python3 - "$@" <<'PY'
import pathlib
import re
import subprocess
import sys

root = pathlib.Path.cwd()
tiers = {"Foundation": 0, "Models": 1, "Services": 2, "UI": 3, "Features": 4, "App": 5}

tracked = subprocess.run(
    ["git", "ls-files", "--cached", "--others", "--exclude-standard"], capture_output=True, text=True, check=True
).stdout.split()
modules = {}
for manifest in sorted(p for p in tracked if p.endswith("/Project.swift")):
    directory = pathlib.Path(manifest).parent
    parts = directory.parts
    tier = parts[1] if parts[0] == "Core" else ("Features" if parts[0] == "Features" else "App")
    # Test dependencies come after `testDependencies`; only the module's own target counts here.
    main = (root / manifest).read_text().split("testDependencies")[0]
    modules[directory.name] = {
        "tier": tier,
        "projects": re.findall(r'\.project\(target:\s*"([A-Za-z0-9_]+)"', main),
        "externals": re.findall(r'\.external\(name:\s*"([A-Za-z0-9_]+)"', main),
        "sources": directory / "Sources",
    }

import_line = re.compile(
    r"^\s*(?:@[\w]+(?:\([^)]*\))?\s+)*(?:public |package |internal |fileprivate |private )?"
    r"import (?:typealias |struct |class |enum |protocol |let |var |func )?(\w+)",
    re.M,
)
problems = []
same_tier = []
for name, module in sorted(modules.items()):
    imported = set()
    for source in (root / module["sources"]).rglob("*.swift"):
        imported |= set(import_line.findall(source.read_text()))
    for dependency in module["projects"]:
        target = modules.get(dependency)
        if target is None:
            problems.append(f"{name} depends on {dependency}, which isn't a module here")
            continue
        if tiers[target["tier"]] > tiers[module["tier"]]:
            problems.append(f"{name} ({module['tier']}) depends up a tier on {dependency} ({target['tier']})")
        elif module["tier"] == "Features" and target["tier"] == "Features":
            problems.append(f"{name} depends on another feature, {dependency}: bind a seam in the app instead")
        elif target["tier"] == module["tier"]:
            same_tier.append(f"{name} → {dependency}")
    for dependency in module["projects"] + module["externals"]:
        if dependency not in imported:
            problems.append(f"{name} declares {dependency} but no file in Sources imports it")
    for dependency in sorted(imported & modules.keys() - set(module["projects"]) - {name}):
        problems.append(f"{name} imports {dependency} without declaring it in Project.swift")

if problems:
    print("Module graph problems:")
    for problem in problems:
        print(f"  - {problem}")
    sys.exit(1)
print(f"Checked {len(modules)} modules: dependencies point down, features stay apart, every one is declared and used.")
if same_tier:
    print("Same-tier service edges (allowed; Tuist rejects cycles): " + ", ".join(same_tier))
PY
